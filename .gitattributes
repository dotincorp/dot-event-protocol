# This repository is a cross-platform contract: the schema, the fixtures and the
# generated SDKs are compared byte-for-byte by `codegen:check` and are pinned by
# SHA-256 elsewhere. Letting the checkout rewrite line endings makes identical
# content look changed, so everything is normalised to LF on every platform.
* text=auto eol=lf

# Windows batch files are read by cmd.exe, which is not reliable with LF.
# This is the one place the repository keeps CRLF on purpose.
*.bat text eol=crlf
